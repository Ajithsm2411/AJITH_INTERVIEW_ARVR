# ==============================================================================
# VR Telepresence AI Interview Platform — Backend Environment Configuration
# Spec Section 14: Security and Reliability
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=development
USE_HTTPS=false
SSL_KEY_PATH=./certs/key.pem
SSL_CERT_PATH=./certs/cert.pem

# Allowed CORS Origins (Client WebXR and Desktop Frontends)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000,https://localhost:5001

# Database Configuration (SQLite default)
DATABASE_PATH=./data/interview_platform.db

# AI & LLM Service Credentials (Gemini & OpenAI)
# Stored strictly in backend environment variables — never exposed to client
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-pro
OPENAI_API_KEY=your_openai_api_key_here

# Speech-to-Text & Text-to-Speech Settings
SPEECH_RECOGNITION_PROVIDER=whisper_fallback
TTS_VOICE_NAME=en-US-DrVance-Neural
REQUEST_TIMEOUT_MS=15000
MAX_API_RETRIES=3

# Audio Upload & Retention Constraints (Spec Section 12 & 14)
# Audio retention is FALSE by default unless explicit candidate consent is granted
ALLOW_AUDIO_RETENTION_WITH_CONSENT=false
MAX_AUDIO_UPLOAD_SIZE_BYTES=26214400 # 25 MB max
ALLOWED_AUDIO_MIME_TYPES=audio/webm,audio/wav,audio/ogg,audio/mpeg

# Security & Session Protection
SESSION_SECRET=super_secret_vr_interview_session_key_99
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
